-- Elsewhere: the `MAX_*` / `MIN_TREE_SIZE` value specs are in `Proofs.lean` (`MAX_*.spec_value`,
-- one per constant, no `willYield` layer); the `to_tree_index` pair, `TreeNodeIndex.u32` and
-- `TreeSize.leaf_count` triples are in `PureSpecs.lean` (single `@[spec]` per transparent function).

-- The two `CoreModels` body walks that the `log2` / `TreeSize.valid` proofs below step through —
-- `openmls.u32_leading_zeros_partialSpec` and `openmls.u32_pow_partialSpec_total` — are proved
-- once in `MissingCoreSpecs.lean` and used directly here.

/-! ### `log2` -/

/-- `log2 x = Nat.log 2 x`, for every `x` including `0` (the guarded branch returns `0`, and
`Nat.log 2 0 = 0`). Total: `leading_zeros` is a pure model, and `31 − lz x` cannot underflow
because `lz x ≤ 31` whenever `x ≠ 0`. -/
private theorem log2_partialSpec (x : Std.U32) :
    Aeneas.Std.WP.partialSpec (log2 x)
      (fun r => (↑r : Nat) = Nat.log 2 (↑x : Nat)) (fun _ => False) False := by
  unfold log2
  split
  · rename_i h
    have hx : (↑x : Nat) = 0 := by simp [h]
    simp only [Aeneas.Std.WP.partialSpec_ok, hx, Nat.log_zero_right]
    rfl
  · rename_i h
    have hx : (↑x : Nat) ≠ 0 := by
      intro hc; apply h; scalar_tac
    have hlog : Nat.log 2 (↑x : Nat) ≤ 31 := by
      have : (↑x : Nat) < 2 ^ 32 := by scalar_tac
      have := Nat.log_lt_of_lt_pow hx this
      omega
    refine partialSpec_bind_fail (u32_leading_zeros_partialSpec x) ?_
    intro lz hlz
    rw [if_neg hx] at hlz
    have h31 : ((31#u32 : Std.U32) : Nat) = 31 := by scalar_tac
    refine partialSpec_bind_fail (partialSpec_of_spec (Std.U32.sub_spec.step_spec ?_)) ?_
    · rw [hlz, h31]; omega
    · intro s hs
      have hsv : (↑s : Nat) = Nat.log 2 (↑x : Nat) := by rw [hs.1, h31, hlz]; omega
      have hcast : ((UScalar.cast .Usize s : Std.Usize) : Nat) = (↑s : Nat) := by scalar_tac
      simp only [Aeneas.Std.WP.partialSpec_ok, hcast, hsv]

/-- `log2 x = Nat.log 2 x`. Total, so no `willFail` hypothesis: stepping a `log2` in hypothesis
position produces no side goal. -/
@[spec]
theorem log2_mvcgen_spec (x : Std.U32) :
    ⦃ ⌜ True ⌝ ⦄ log2 x ⦃ ⇓ r => ⌜ (↑r : Nat) = Nat.log 2 (↑x : Nat) ⌝ ⦄ := by
  apply triple_of_partialSpec (log2_partialSpec x) <;> try grind

/-! ### `TreeSize.valid` -/

set_option maxRecDepth 8000 in
/-- `TreeSize::valid` is `1 ≤ self ∧ self ≤ MAX_TREE_SIZE ∧ self = 2^(log₂ self + 1) − 1`, where
`MAX_TREE_SIZE = 2^30` — note the guard is *inclusive* of `2^30`.

**Total.** The `self ≤ MAX_TREE_SIZE` guard runs BEFORE the `pow`, so under it `log₂ self ≤ 30`,
the exponent `log₂ self + 1 ≤ 31`, and `2^31 ≤ u32::MAX` — `tryMk` never fails. The `Usize → U32`
cast is in range and the final `− 1` cannot underflow. Hence no `willFail` hypothesis, and stepping
a `TreeSize.valid` in hypothesis position produces no side goal.

The body decides `self = i5` on `U32`; the characterization states the third conjunct on `Nat`,
which is equivalent by `UScalar` value injectivity. The postcondition is instantiated directly
(rather than universally quantified over the returned `Bool`) so that no `Decidable` instance is
ever forced open during elaboration.

**Internal stepping stone only** — the raw body-walk in the `Nat.log` fixpoint shape the extracted
code computes. `private` and NOT `@[spec]`-registered: that equation is self-referential in `self`
and makes `scalar_tac` diverge in consumers. The registered rule is `TreeSize.valid_mask_spec`
below, which transports this through `all_ones_iff_and_succ_eq_zero`. -/
private theorem TreeSize.valid_log_characterization (self : TreeSize)
    (Q : PostCond Bool Aeneas.Std.Result.postShape)
    (h_ok : Aeneas.Std.willYield
      (decide (1 ≤ (↑self : Nat) ∧ (↑self : Nat) ≤ 2 ^ 30 - 1 ∧
        (↑self : Nat) = 2 ^ (Nat.log 2 (↑self : Nat) + 1) - 1)) Q) :
    ⦃ ⌜ True ⌝ ⦄ TreeSize.valid self ⦃ Q ⦄ := by
  refine triple_of_partialSpec (p_fail := fun _ => False) (p_div := False)
    (p_ok := fun b => b = decide (1 ≤ (↑self : Nat) ∧ (↑self : Nat) ≤ 2 ^ 30 - 1 ∧
      (↑self : Nat) = 2 ^ (Nat.log 2 (↑self : Nat) + 1) - 1))
    ?_ Q (fun b hb => by rw [hb]; exact h_ok) (by simp) (by simp)
  have h1u : ((1#u32 : Std.U32) : Nat) = 1 := by scalar_tac
  have h2u : ((2#u32 : Std.U32) : Nat) = 2 := by scalar_tac
  have hpow30 : (2 : Nat) ^ 30 - 1 = 1073741823 := by norm_num
  have hmax : binary_tree.array_representation.treemath.MAX_TREE_SIZE = ok 1073741823#u32 := by
    unfold MAX_TREE_SIZE; rfl
  unfold TreeSize.valid
  rw [hmax]
  simp only [bind_tc_ok]
  split
  · rename_i hmin
    have h1 : 1 ≤ (↑self : Nat) := by unfold MIN_TREE_SIZE at hmin; scalar_tac
    split
    · rename_i hle
      have h2 : (↑self : Nat) ≤ 2 ^ 30 - 1 := by rw [hpow30]; scalar_tac
      have hlog : Nat.log 2 (↑self : Nat) ≤ 30 := by
        have h2' : (↑self : Nat) ≤ 2 ^ 30 := le_trans h2 (by norm_num)
        have h := Nat.log_mono_right (b := 2) h2'
        rwa [Nat.log_pow (by omega)] at h
      refine partialSpec_bind_fail (log2_partialSpec self) ?_
      intro k hk
      refine partialSpec_bind_fail
        (partialSpec_of_spec (Aeneas.Std.UScalar.cast_inBounds_spec (src_ty := .Usize) .U32 k
          (by simp only [Aeneas.Std.UScalar.max, Std.UScalarTy.numBits]; omega))) ?_
      intro c hc
      · have hcv : (↑c : Nat) = Nat.log 2 (↑self : Nat) := by rw [hc, hk]
        refine partialSpec_bind_fail
          (partialSpec_of_spec (Std.U32.add_spec.step_spec (x := c) (y := 1#u32) ?_)) ?_
        · simp only [h1u, hcv]; scalar_tac
        · intro e he
          have hee : (↑e : Nat) = Nat.log 2 (↑self : Nat) + 1 := by rw [he, h1u, hcv]
          have hpb : (2 : Nat) ^ (↑e : Nat) ≤ 2 ^ 31 :=
            Nat.pow_le_pow_right (by omega) (by omega)
          refine partialSpec_bind_fail (u32_pow_partialSpec_total 2#u32 e ?_) ?_
          · simp only [Aeneas.Std.UScalar.max, Std.UScalarTy.numBits, h2u]; omega
          · intro pw hpw
            have hpwv : (↑pw : Nat) = 2 ^ (Nat.log 2 (↑self : Nat) + 1) := by
              rw [hpw, h2u, hee]
            refine partialSpec_bind_fail
              (partialSpec_of_spec (Std.U32.sub_spec.step_spec (x := pw) (y := 1#u32) ?_)) ?_
            · rw [h1u, hpwv]
              have : 1 ≤ (2 : Nat) ^ (Nat.log 2 (↑self : Nat) + 1) := Nat.one_le_two_pow
              omega
            · intro d hd
              have hdv : (↑d : Nat) = 2 ^ (Nat.log 2 (↑self : Nat) + 1) - 1 := by
                rw [hd.1, h1u, hpwv]
              have hiff : (self = d) ↔ (1 ≤ (↑self : Nat) ∧ (↑self : Nat) ≤ 2 ^ 30 - 1 ∧
                  (↑self : Nat) = 2 ^ (Nat.log 2 (↑self : Nat) + 1) - 1) := by
                refine ⟨fun hEq => ⟨h1, h2, ?_⟩, fun hC => ?_⟩
                · exact (by rw [hEq] : (↑self : Nat) = (↑d : Nat)).trans hdv
                · have hv : (↑self : Nat) = (↑d : Nat) := by rw [hC.2.2, hdv]
                  exact Aeneas.Std.UScalar.eq_of_val_eq hv
              exact decide_eq_decide.mpr hiff
    · rename_i hle
      have hnot : ¬ (1 ≤ (↑self : Nat) ∧ (↑self : Nat) ≤ 2 ^ 30 - 1 ∧
          (↑self : Nat) = 2 ^ (Nat.log 2 (↑self : Nat) + 1) - 1) := by
        rintro ⟨-, hb, -⟩; rw [hpow30] at hb; scalar_tac
      exact (decide_eq_false hnot).symm
  · rename_i hmin
    unfold MIN_TREE_SIZE at hmin
    have hnot : ¬ (1 ≤ (↑self : Nat) ∧ (↑self : Nat) ≤ 2 ^ 30 - 1 ∧
        (↑self : Nat) = 2 ^ (Nat.log 2 (↑self : Nat) + 1) - 1) := by
      rintro ⟨ha, -, -⟩; scalar_tac
    exact (decide_eq_false hnot).symm

/-- **The** spec for `TreeSize::valid` (the `@[spec]`-registered rule). Decides
`1 ≤ s ∧ s ≤ 2^30 − 1 ∧ s &&& (s+1) = 0`: the third conjunct is the all-ones bit test, NOT the
`Nat.log` fixpoint equation the extracted body computes (equivalent under `1 ≤ s` by
`all_ones_iff_and_succ_eq_zero`). The mask shape is the `scalar_tac`-safe one — no `Nat.log` reaches
a consumer's context, so no `set`/`clear_value` quarantine preamble is needed anywhere.

CONSUMER RECIPE: fires under plain `hax_mvcgen [...]`, no erasure pair. To *use* a mask hypothesis
quantitatively go through `all_ones_of_and_succ_eq_zero` (fresh existential witness); to *produce*
one from a known all-ones value use `and_succ_eq_zero_of_all_ones`. `&&&` is opaque to `omega`, so
an explicit `pow_succ`-expanded `have` is usually needed alongside.

**Total** (as the underlying body walk): no `willFail` hypothesis, so stepping this in hypothesis
position produces no side goal. -/
@[spec]
theorem TreeSize.valid_mask_spec (self : TreeSize)
    (Q : PostCond Bool Aeneas.Std.Result.postShape)
    (h_ok : Aeneas.Std.willYield
      (decide (1 ≤ (↑self : Nat) ∧ (↑self : Nat) ≤ 2 ^ 30 - 1 ∧
        (↑self : Nat) &&& ((↑self : Nat) + 1) = 0)) Q) :
    ⦃ ⌜ True ⌝ ⦄ TreeSize.valid self ⦃ Q ⦄ := by
  refine TreeSize.valid_log_characterization self Q ?_
  have hiff : (1 ≤ (↑self : Nat) ∧ (↑self : Nat) ≤ 2 ^ 30 - 1 ∧
      (↑self : Nat) = 2 ^ (Nat.log 2 (↑self : Nat) + 1) - 1) ↔
      (1 ≤ (↑self : Nat) ∧ (↑self : Nat) ≤ 2 ^ 30 - 1 ∧
        (↑self : Nat) &&& ((↑self : Nat) + 1) = 0) := by
    constructor
    · rintro ⟨ha, hb, hc⟩
      exact ⟨ha, hb, (all_ones_iff_and_succ_eq_zero _ ha).mp hc⟩
    · rintro ⟨ha, hb, hc⟩
      exact ⟨ha, hb, (all_ones_iff_and_succ_eq_zero _ ha).mpr hc⟩
  rw [decide_eq_decide.mpr hiff]
  exact h_ok

end binary_tree.array_representation.treemath

end openmls
