-- [openmls]: PROVED mvcgen-style `@[spec]` triples for the treemath *spec-vocabulary* functions —
-- the helpers (`valid`, `log2`, `u32`, `leaf_count`, `parent_count`, …) that appear inside
-- extraction-generated preconditions and postconditions.
--
-- Purpose: when `hax_mvcgen` steps a pre/post in HYPOTHESIS position, success is already given, so
-- a total spec's precondition becomes a spurious side goal. These triples are stated in the shape
-- `@[step]` derives for `partialSpec` theorems (generic `Q : PostCond α Result.postShape` with one
-- `willYield`/`willFail` hypothesis per outcome; cf. `@Aeneas.Std.U8.add_spec.mvcgen_spec`), so a
-- failure branch *recovers* its bound instead of discharging it. Companion to the `CoreModels` trio
-- at the end of `MissingCoreSpecs.lean`, which this file imports: the `CoreModels` `u32` body walks
-- (`u32_leading_zeros_partialSpec`, `u32_pow_partialSpec{,_total}`) live there and are reused here
-- rather than repeated.
--
-- Every theorem here is discharged (no `sorry`), so this file is NOT part of the trusted audit
-- surface. Hand-written; not regenerated by extraction.
--
-- NOTE: `level` is deliberately absent — its body is `trailing_ones()` (no loop), so stepping it
-- goes through the registered `level.spec_pure` in `Proofs.lean`, at the cost of discharging its
-- `< 2^30` hypothesis at each site.
import Aeneas
import CoreModels
import Openmls.Extraction.Types
import Openmls.Extraction.Funs
import Openmls.Extraction.Specs
import Openmls.Proofs.Common
import Openmls.Proofs.BitMath
import Openmls.Proofs.MissingCoreSpecs
open CoreModels Aeneas
open Aeneas.Std hiding namespace core alloc
open Result ControlFlow Error
open Std.Do
set_option linter.dupNamespace false
set_option linter.hashCommand false
set_option linter.unusedVariables false
set_option maxRecDepth 2048

noncomputable section

namespace openmls

set_option mvcgen.warning false
set_option hax_mvcgen.warnings false

namespace binary_tree.array_representation.treemath

-- The generic bridge `triple_of_partialSpec`, used throughout, lives in `Openmls.Proofs.Common`.

/-- Specialisation of `openmls.triple_of_partialSpec` for the (common) case of a total operation
whose body has already been reduced to `ok v`: the triple is exactly `willYield v Q`.
Named apart from `openmls.triple_of_ok` (the `x = ok v` / plain-`Prop` postcondition flavour in
`Common`), which it would otherwise shadow inside this namespace. -/
theorem triple_of_ok_willYield {α} (v : α) (Q : PostCond α Aeneas.Std.Result.postShape)
    (h_ok : Aeneas.Std.willYield v Q) :
    ⦃ ⌜ True ⌝ ⦄ (ok v : Result α) ⦃ Q ⦄ := by
  simpa [Triple, _root_.Std.Do.WP.wp, PredTrans.apply, Aeneas.Std.willYield] using h_ok

/-- A total `spec` yields the partial contract with empty failure/divergence cases. Lets us reuse
Aeneas' `@[step]`-derived `.step_spec` lemmas (which discharge the failure side conditions once,
here) to build the partial contracts below. -/
theorem partialSpec_of_spec {α} {x : Result α} {P : α → Prop}
    (h : Aeneas.Std.WP.spec x P) :
    Aeneas.Std.WP.partialSpec x P (fun _ => False) False := by
  obtain ⟨v, hv, hP⟩ := Aeneas.Std.WP.spec_imp_exists h
  simp [hv, hP, Aeneas.Std.WP.partialSpec]

/-! ### `valid` predicates (all total — they only read constants and compare) -/

/-- `LeafNodeIndex::valid` is `self ≤ MAX_LEAF = 2^29 − 1`. Total: it reads a constant and
compares, so there is no failure branch and hence no `willFail` hypothesis — stepping it in
hypothesis position produces no side goal. -/
@[spec]
theorem LeafNodeIndex.valid_mvcgen_spec (self : LeafNodeIndex)
    (Q : PostCond Bool Aeneas.Std.Result.postShape)
    (h_ok : ∀ b : Bool, b = decide ((↑self : Nat) ≤ 2 ^ 29 - 1) →
      Aeneas.Std.willYield b Q) :
    ⦃ ⌜ True ⌝ ⦄ LeafNodeIndex.valid self ⦃ Q ⦄ := by
  have hc : binary_tree.array_representation.treemath.MAX_LEAF = ok 536870911#u32 := by
    unfold MAX_LEAF MAX_TREE_INDEX MAX_TREE_SIZE; rfl
  unfold LeafNodeIndex.valid
  rw [hc]
  exact triple_of_ok_willYield _ Q (h_ok _ (by norm_num))

/-- `ParentNodeIndex::valid` is `self ≤ MAX_PARENT = 2^29 − 2`. Total, as for `LeafNodeIndex`. -/
@[spec]
theorem ParentNodeIndex.valid_mvcgen_spec (self : ParentNodeIndex)
    (Q : PostCond Bool Aeneas.Std.Result.postShape)
    (h_ok : ∀ b : Bool, b = decide ((↑self : Nat) ≤ 2 ^ 29 - 2) →
      Aeneas.Std.willYield b Q) :
    ⦃ ⌜ True ⌝ ⦄ ParentNodeIndex.valid self ⦃ Q ⦄ := by
  have hc : binary_tree.array_representation.treemath.MAX_PARENT = ok 536870910#u32 := by
    unfold MAX_PARENT MAX_LEAF MAX_TREE_INDEX MAX_TREE_SIZE; rfl
  unfold ParentNodeIndex.valid
  rw [hc]
  exact triple_of_ok_willYield _ Q (h_ok _ (by norm_num))

/-- `TreeNodeIndex::valid` dispatches on the constructor to the leaf/parent bound. Total. -/
@[spec]
theorem TreeNodeIndex.valid_mvcgen_spec (self : TreeNodeIndex)
    (Q : PostCond Bool Aeneas.Std.Result.postShape)
    (h_ok : ∀ b : Bool, b = (match self with
        | TreeNodeIndex.Leaf l => decide ((↑l : Nat) ≤ 2 ^ 29 - 1)
        | TreeNodeIndex.Parent p => decide ((↑p : Nat) ≤ 2 ^ 29 - 2)) →
      Aeneas.Std.willYield b Q) :
    ⦃ ⌜ True ⌝ ⦄ TreeNodeIndex.valid self ⦃ Q ⦄ := by
  unfold TreeNodeIndex.valid
  cases self with
  | Leaf l => exact LeafNodeIndex.valid_mvcgen_spec l Q (fun b hb => h_ok b (by simpa using hb))
  | Parent p => exact ParentNodeIndex.valid_mvcgen_spec p Q (fun b hb => h_ok b (by simpa using hb))

/-- `TreeSize::u32` is the identity injection. Total. -/
@[spec]
theorem TreeSize.u32_mvcgen_spec (self : TreeSize)
    (Q : PostCond Std.U32 Aeneas.Std.Result.postShape)
    (h_ok : ∀ r : Std.U32, (↑r : Nat) = (↑self : Nat) → Aeneas.Std.willYield r Q) :
    ⦃ ⌜ True ⌝ ⦄ TreeSize.u32 self ⦃ Q ⦄ := by
  unfold TreeSize.u32
  exact triple_of_ok_willYield _ Q (h_ok _ rfl)

/-- `TreeSize::parent_count` is `self / 2`. Total: the divisor is the literal `2`, so the
division cannot fail. -/
@[spec]
theorem TreeSize.parent_count_mvcgen_spec (self : TreeSize)
    (Q : PostCond Std.U32 Aeneas.Std.Result.postShape)
    (h_ok : ∀ r : Std.U32, (↑r : Nat) = (↑self : Nat) / 2 → Aeneas.Std.willYield r Q) :
    ⦃ ⌜ True ⌝ ⦄ TreeSize.parent_count self ⦃ Q ⦄ := by
  unfold TreeSize.parent_count
  refine triple_of_partialSpec (p_fail := fun _ => False) (p_div := False) ?_ Q h_ok
    (by simp) (by simp)
  refine partialSpec_of_spec ?_
  have h := Std.U32.div_spec.step_spec (x := self) (y := 2#u32) (by simp)
  exact h

/-- Weakening of a partial-contract in both the success and the failure predicate. -/
theorem partialSpec_weaken {α} {x : Result α} {P P' : α → Prop}
    {pf pf' : Aeneas.Std.Error → Prop}
    (h : Aeneas.Std.WP.partialSpec x P pf False)
    (hP : ∀ a, P a → P' a) (hF : ∀ e, pf e → pf' e) :
    Aeneas.Std.WP.partialSpec x P' pf' False := by
  cases x <;> simp_all [Aeneas.Std.WP.partialSpec]

/-- Chaining for partial-contracts that share a failure predicate (both steps may fail). -/
theorem partialSpec_bind_fail {α β} {x : Result α} {f : α → Result β}
    {P : α → Prop} {R : β → Prop} {pf : Aeneas.Std.Error → Prop}
    (hx : Aeneas.Std.WP.partialSpec x P pf False)
    (hf : ∀ a, P a → Aeneas.Std.WP.partialSpec (f a) R pf False) :
    Aeneas.Std.WP.partialSpec (x >>= f) R pf False := by
  cases x <;> simp_all [Aeneas.Std.WP.partialSpec]

