import Openmls.Proofs.PureSpecs
import Openmls.Proofs.MissingCoreSpecs
open CoreModels Aeneas
open Aeneas.Std hiding namespace core alloc
open Result ControlFlow Error
open Std.Do
set_option linter.dupNamespace false
set_option linter.hashCommand false
set_option linter.unusedVariables false

-- set_option maxRecDepth 2048

noncomputable section

namespace openmls
namespace binary_tree.array_representation.treemath

set_option mvcgen.warning false
set_option hax_mvcgen.warnings false
set_option linter.unusedTactic false

-- DOUBLE AUTHORITY (build-verified, load-bearing).  This bare block registers extracted
-- *definitions* for body-unfolding; several of the ops below ALSO carry a hand `*_mvcgen_spec`
-- triple, and BOTH authorities are required.  `TreeSize.{u32,leaf_count,parent_count}`,
-- `{Leaf,Parent}NodeIndex.u32`, `TreeNodeIndex.u32` and both `to_tree_index` are irreducibly
-- double-live: the proofs of `parent`, `sibling`, `direct_path`, `lowest_common_ancestor` and
-- `is_node_in_tree` consume the unfolded body at some VCs and the triple at others, so dropping
-- the def registration here breaks them, and dropping the triples instead breaks even more.
-- mvcgen's resolution order between the two authorities is load-bearing: do not remove either side
-- without repairing the consuming proof bodies.
attribute [spec]
  pure
  MIN_TREE_SIZE
  --
  --log2
  is_node_in_tree
  --
  TreeSize.u32
  TreeSize.leaf_count
  TreeSize.parent_count
  --
  TreeNodeIndex.new
  TreeNodeIndex.u32
  --
  LeafNodeIndex.new
  LeafNodeIndex.u32
  LeafNodeIndex.to_tree_index
  LeafNodeIndex.from_tree_index
  --
  ParentNodeIndex.new
  ParentNodeIndex.u32
  ParentNodeIndex.to_tree_index
  ParentNodeIndex.from_tree_index

