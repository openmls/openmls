  case vc9.h =>
    rename_i hx hy hxy xv hxv yv hyv kx hkx kx1 hkx1 ky hky ky1 hky1 hle sx hsx sy hsy hne
      hle2 tx htx ty hty heq
    exfalso
    exact lca_shift_ne heq hxy hxv hyv (lca_level_one hxv hkx hkx1).1 htx hty
  case vc10.h =>
